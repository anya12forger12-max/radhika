rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Authorization must never depend on a client-writable field.
    // Admin privileges are granted exclusively through Firebase
    // Authentication custom claims (request.auth.token.admin == true).

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // User files - only the owner can access
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin-only access - server-issued 'admin' custom claim only
    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // App assets - publicly readable, writable by admins only
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}