build/
.dart_tool/
.flutter-plugins-dependencies
.idea/
.vscode/

android/
ios/
linux/
macos/
windows/
integration_test/
test/
docs/
firebase/

.git/
.github/
.gitignore
.aider*
*.iml
*.log

# Local secrets / platform config never shipped to the web build
.env
.env.*
!.env.example
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
