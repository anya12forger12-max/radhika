rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Authorization must never depend on a client-writable field.
    // Admin privileges are granted exclusively through Firebase
    // Authentication custom claims (request.auth.token.admin == true), which
    // only a trusted server / Admin SDK can issue. Health data is stored
    // locally on-device (Hive); these rules cover the reserved backend model
    // for future server-controlled features and are deny-by-default.

    // Server-controlled admin gate: only a server-issued Authentication
    // custom claim grants admin access. request.auth.token is not
    // client-writable.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // User profiles - only the owner can access their own document, and the
    // owner can never set the reserved 'role' field.
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // A normal user must never be able to grant themselves elevated
      // permissions, so any create/update carrying a reserved 'role' field is
      // rejected.
      function doesNotSetRole() {
        return !request.resource.data.keys().hasAny(['role']);
      }

      allow read: if isOwner();
      allow create: if isOwner() && doesNotSetRole();
      allow update: if isOwner() && doesNotSetRole();
      allow delete: if isOwner();

      match /cycles/{cycleId} {
        allow read, write: if isOwner();
      }

      match /predictions/{predictionId} {
        // Prediction results are generated by trusted application logic and
        // must not be freely rewritten by the client. Clients may read their
        // own predictions only.
        allow read: if isOwner();
      }

      match /reminders/{reminderId} {
        allow read, write: if isOwner();
      }

      match /symptoms/{symptomId} {
        allow read, write: if isOwner();
      }
    }

    // Admin access - only users holding the server-issued 'admin' custom
    // claim.
    match /admin/{document} {
      allow read, write: if isAdmin();
    }

    // App settings - readable by all authenticated users, writable by admins
    // only.
    match /appSettings/{setting} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}